# URL pública final, sin barra al final
NEXT_PUBLIC_SITE_URL=https://lynex.dev
NEXT_PUBLIC_CONTACT_EMAIL=hola@lynex.dev
# Opcionales: se ocultan automáticamente cuando quedan vacíos
# WhatsApp usa solo dígitos, con código de país (ej. 595981123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Formato visible/internacional (ej. +595 981 123 456)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
# Texto libre con moneda (ej. Gs. 4.000.000)
NEXT_PUBLIC_WEB_PRICE_FROM=
NEXT_PUBLIC_SYSTEM_PRICE_FROM=

# Formulario de contacto (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=hola@lynex.dev
CONTACT_FROM_EMAIL=Lynex <contacto@tu-dominio-verificado.com>
