# URL pública final, sin barra al final
NEXT_PUBLIC_SITE_URL=https://lynex.dev
NEXT_PUBLIC_CONTACT_EMAIL=martinezlynex@gmail.com
# Contacto público de Lynex
# WhatsApp usa solo dígitos, con código de país (ej. 595981123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=595986914726
# Formato visible/internacional (ej. +595 981 123 456)
NEXT_PUBLIC_CONTACT_PHONE=+595 986 914 726
# Opcionales: se ocultan automáticamente cuando quedan vacíos
NEXT_PUBLIC_LINKEDIN_URL=
# Precio mensual visible, con moneda y período (ej. Desde Gs. 500.000/mes)
NEXT_PUBLIC_WEB_PRICE_FROM=
NEXT_PUBLIC_SYSTEM_PRICE_FROM=

# URL pública del backend del diagnóstico. En un despliegue Next.js completo
# puede omitirse; en GitHub Pages debe apuntar al servidor que expone /api/intake.
NEXT_PUBLIC_INTAKE_API_URL=

# Diagnóstico: almacenamiento durable, correo y reintentos
DATABASE_URL=postgresql://usuario:clave@servidor:5432/lynex
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=martinezlynex@gmail.com
CONTACT_FROM_EMAIL=Lynex <contacto@tu-dominio-verificado.com>
# Valores largos y aleatorios; no deben llevar el prefijo NEXT_PUBLIC_.
CRON_SECRET=reemplazar-por-un-secreto-largo
RATE_LIMIT_SECRET=reemplazar-por-otro-secreto-largo
# Orígenes adicionales separados por coma si el formulario y la API usan dominios distintos.
INTAKE_ALLOWED_ORIGINS=https://j0nasm.github.io
